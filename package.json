{
  "name": "crypto-payment-widget-monorepo",
  "version": "1.0.0",
  "description": "Drop-in crypto payment widget using WalletConnect SDK with smart contracts",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build:contracts && npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:contracts": "hardhat compile",
    "start": "npm run start --workspace=backend",
    "start:frontend": "npm run preview --workspace=frontend",
    "test": "npm run test:contracts && npm run test:frontend && npm run test:backend",
    "test:frontend": "npm run test --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "test:contracts": "hardhat test",
    "test:coverage": "hardhat coverage",
    "compile": "hardhat compile",
    "deploy:local": "hardhat run contracts/scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run contracts/scripts/deploy.ts --network sepolia",
    "deploy:base": "hardhat run contracts/scripts/deploy.ts --network base",
    "deploy:mainnet": "hardhat run contracts/scripts/deploy.ts --network mainnet",
    "node": "hardhat node",
    "lint": "npm run lint:frontend && npm run lint:backend && npm run lint:contracts",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "lint:contracts": "solhint 'contracts/**/*.sol'",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,sol}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,sol}\"",
    "type-check": "npm run type-check --workspaces --if-present",
    "clean": "rm -rf node_modules artifacts cache coverage && npm run clean --workspaces --if-present",
    "verify": "hardhat verify",
    "gas-report": "REPORT_GAS=true hardhat test"
  },
  "keywords": [
    "crypto",
    "payment",
    "walletconnect",
    "widget",
    "smart-contracts",
    "ethereum",
    "blockchain",
    "web3"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "concurrently": "^8.2.2",
    "hardhat": "^2.27.0",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^4.5.4"
  },
  "dependencies": {
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "dotenv": "^17.2.3"
  }
}
